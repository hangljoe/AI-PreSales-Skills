# OS
.DS_Store
Thumbs.db

# Environment variables (never commit secrets)
.env
*.env.local

# Packaging output (generated by package-skills.yml)
dist/

# Generated deliverables (audit reports, branded docs, demo data)
output/

# Claude local settings (machine-specific, not for distribution)
.claude/settings.local.json

# Editor
.vscode/
.vscode/launch.json

# Python
__pycache__/
*.pyc
*.pyo

# Python virtual environments (uv sync, e.g. diagram renderer)
.venv/
*.egg-info/

# Keys and certificates (never commit)
*.pem
*.key
*.p12
*.pfx
config.local.*
secrets.*

# Agent workspace (generated/temp files)
.agent/reports/
.agent/external-docs/
.agents/
